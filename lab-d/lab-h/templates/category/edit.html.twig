{% extends 'base.html.twig' %}

{% block title %}Edycja kategorii{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <p class="page-kicker">Aktualizacja wpisu</p>
            <h1 class="page-title">Edytuj kategorię</h1>
            <p class="page-subtitle mb-0">Wprowadź zmiany i zapisz je w kolekcji.</p>
        </div>
    </div>
    <div class="content-card form-panel p-3 p-md-4">
        {{ include('category/_form.html.twig', {'button_label': 'Zapisz zmiany'}) }}
        <div class="d-flex flex-wrap gap-2 mt-2">
            <a class="btn btn-link px-0" href="{{ path('app_category_index') }}">Wróć do listy</a>
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
