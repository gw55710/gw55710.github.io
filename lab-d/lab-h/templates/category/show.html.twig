{% extends 'base.html.twig' %}

{% block title %}Szczegóły kategorii{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <p class="page-kicker">Karta kategorii</p>
            <h1 class="page-title">Szczegóły</h1>
            <p class="page-subtitle mb-0">Informacje o wybranej kategorii.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('app_category_edit', {'id': category.id}) }}">Edytuj kategorię</a>
    </div>

    <div class="content-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <tbody>
                    <tr>
                        <th scope="row">Numer</th>
                        <td><span class="record-id">{{ category.id }}</span></td>
                    </tr>
                    <tr>
                        <th scope="row">Tiry</th>
                        <td class="category-name">{{ category.tiry }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Tirowcy</th>
                        <td>{{ category.tirowcy }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <a class="btn btn-outline-secondary" href="{{ path('app_category_index') }}">Wróć do listy</a>
        {{ include('category/_delete_form.html.twig') }}
    </div>
{% endblock %}
